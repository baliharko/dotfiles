# ghostty +show-config --default --docs

shell-integration-features = no-cursor
cursor-style = block

font-feature = -calt, -liga, -dlig, -hlig, -clig
font-family = "Jetbrains Mono Nerd Font"

theme = kanagawabones

# Slightly see-through background with the native macOS glass effect (macOS
# 26+). The blur only applies while the opacity is below 1. On macOS a change
# to the opacity only takes effect after quitting and reopening Ghostty.
background-opacity = 0.9
background-blur = macos-glass-regular

macos-titlebar-style = hidden

window-padding-balance = true
window-padding-x = 10
window-padding-y = 15

# Quick terminal (quake-style overlay)
keybind = global:super+alt+shift+ctrl+n=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 80%,80%
quick-terminal-animation-duration = 0
quick-terminal-autohide = false
quick-terminal-screen = mouse
